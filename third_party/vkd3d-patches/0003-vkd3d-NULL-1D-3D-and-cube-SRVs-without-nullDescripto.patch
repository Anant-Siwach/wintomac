From ca84e9dcd9fffcf9fbca1fafccb60e6f3f062099 Mon Sep 17 00:00:00 2001
From: wintomac <wintomac@local>
Date: Fri, 6 Nov 2026 13:17:29 +0530
Subject: [PATCH 3/3] vkd3d: NULL 1D, 3D and cube SRVs without nullDescriptor

MoltenVK has no VK_EXT_robustness2 nullDescriptor. libvkd3d emulated NULL SRVs only for buffers and 2D
textures and left other dimensions unwritten, so shaders read whatever view the slot held before, possibly a
destroyed one. Back them with 1x1 1D, 3D and cube images like the 2D case (zero swizzle).
---
 libs/vkd3d/resource.c      | 87 +++++++++++++++++++++++++++++++++++++-
 libs/vkd3d/vkd3d_private.h |  8 ++++
 2 files changed, 94 insertions(+), 1 deletion(-)

diff --git a/libs/vkd3d/resource.c b/libs/vkd3d/resource.c
index f1491cb..d1b8fbe 100644
--- a/libs/vkd3d/resource.c
+++ b/libs/vkd3d/resource.c
@@ -3246,7 +3246,33 @@ static void vkd3d_create_null_srv(struct d3d12_desc *descriptor,
             vkd3d_desc.view_type = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
             break;
 
+        /* wintomac: without nullDescriptor these dimensions used to leave the descriptor unwritten, so shaders
+         * read whatever view the slot held before (possibly a destroyed one). */
+        case D3D12_SRV_DIMENSION_TEXTURE1D:
+        case D3D12_SRV_DIMENSION_TEXTURE1DARRAY:
+            if (device->vk_info.EXT_robustness2 || !null_resources->vk_1d_image)
+                goto robust;
+            vk_image = null_resources->vk_1d_image;
+            vkd3d_desc.view_type = desc->ViewDimension == D3D12_SRV_DIMENSION_TEXTURE1D
+                    ? VK_IMAGE_VIEW_TYPE_1D : VK_IMAGE_VIEW_TYPE_1D_ARRAY;
+            break;
+        case D3D12_SRV_DIMENSION_TEXTURE3D:
+            if (device->vk_info.EXT_robustness2 || !null_resources->vk_3d_image)
+                goto robust;
+            vk_image = null_resources->vk_3d_image;
+            vkd3d_desc.view_type = VK_IMAGE_VIEW_TYPE_3D;
+            break;
+        case D3D12_SRV_DIMENSION_TEXTURECUBE:
+        case D3D12_SRV_DIMENSION_TEXTURECUBEARRAY:
+            if (device->vk_info.EXT_robustness2 || !null_resources->vk_cube_image)
+                goto robust;
+            vk_image = null_resources->vk_cube_image;
+            vkd3d_desc.view_type = desc->ViewDimension == D3D12_SRV_DIMENSION_TEXTURECUBE
+                    ? VK_IMAGE_VIEW_TYPE_CUBE : VK_IMAGE_VIEW_TYPE_CUBE_ARRAY;
+            break;
+
         default:
+        robust:
             if (device->vk_info.EXT_robustness2)
             {
                 vk_image = VK_NULL_HANDLE;
@@ -3265,7 +3291,8 @@ static void vkd3d_create_null_srv(struct d3d12_desc *descriptor,
     vkd3d_desc.miplevel_idx = 0;
     vkd3d_desc.miplevel_count = 1;
     vkd3d_desc.layer_idx = 0;
-    vkd3d_desc.layer_count = 1;
+    vkd3d_desc.layer_count = (vkd3d_desc.view_type == VK_IMAGE_VIEW_TYPE_CUBE
+            || vkd3d_desc.view_type == VK_IMAGE_VIEW_TYPE_CUBE_ARRAY) ? 6 : 1;
     vkd3d_desc.vk_image_aspect = VK_IMAGE_ASPECT_COLOR_BIT;
     vkd3d_desc.components.r = VK_COMPONENT_SWIZZLE_ZERO;
     vkd3d_desc.components.g = VK_COMPONENT_SWIZZLE_ZERO;
@@ -4837,6 +4864,22 @@ static HRESULT vkd3d_init_null_resources_data(struct vkd3d_null_resources *null_
             VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0,
             0, NULL, 0, NULL, 1, &barrier));
 
+    /* the 1D, 3D and cube SRV images: same layout */
+    {
+        VkImage extra[] = {null_resource->vk_1d_image, null_resource->vk_3d_image, null_resource->vk_cube_image};
+        unsigned int j;
+
+        for (j = 0; j < ARRAY_SIZE(extra); ++j)
+        {
+            if (!extra[j])
+                continue;
+            barrier.image = extra[j];
+            VK_CALL(vkCmdPipelineBarrier(vk_command_buffer,
+                    VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0,
+                    0, NULL, 0, NULL, 1, &barrier));
+        }
+    }
+
     if ((vr = VK_CALL(vkEndCommandBuffer(vk_command_buffer))) < 0)
     {
         WARN("Failed to end command buffer, vr %d.\n", vr);
@@ -4975,6 +5018,41 @@ HRESULT vkd3d_init_null_resources(struct vkd3d_null_resources *null_resources,
             &heap_properties, D3D12_HEAP_FLAG_NONE, &null_resources->vk_2d_storage_image_memory, NULL, NULL)))
         goto fail;
 
+    /* 1D, 3D and cube SRV images (wintomac: MoltenVK has no nullDescriptor) */
+    {
+        static const struct { D3D12_RESOURCE_DIMENSION dimension; unsigned int size, layers; } extra[] =
+        {
+            {D3D12_RESOURCE_DIMENSION_TEXTURE1D, 1, 1},
+            {D3D12_RESOURCE_DIMENSION_TEXTURE3D, 1, 1},
+            {D3D12_RESOURCE_DIMENSION_TEXTURE2D, 1, 6},   /* cube compatible: width == height, 6 layers */
+        };
+        VkImage *images[] = {&null_resources->vk_1d_image, &null_resources->vk_3d_image, &null_resources->vk_cube_image};
+        VkDeviceMemory *memories[] = {&null_resources->vk_1d_image_memory, &null_resources->vk_3d_image_memory,
+                &null_resources->vk_cube_image_memory};
+        unsigned int i;
+
+        for (i = 0; i < ARRAY_SIZE(extra); ++i)
+        {
+            resource_desc.Dimension = extra[i].dimension;
+            resource_desc.Alignment = 0;
+            resource_desc.Width = extra[i].size;
+            resource_desc.Height = 1;
+            resource_desc.DepthOrArraySize = extra[i].layers;
+            resource_desc.MipLevels = 1;
+            resource_desc.Format = VKD3D_NULL_VIEW_FORMAT;
+            resource_desc.SampleDesc.Count = 1;
+            resource_desc.SampleDesc.Quality = 0;
+            resource_desc.Layout = D3D12_TEXTURE_LAYOUT_UNKNOWN;
+            resource_desc.Flags = D3D12_RESOURCE_FLAG_NONE;
+            if (FAILED(hr = vkd3d_create_image(device, &heap_properties, D3D12_HEAP_FLAG_NONE,
+                    &resource_desc, NULL, images[i])))
+                goto fail;
+            if (FAILED(hr = vkd3d_allocate_image_memory(device, *images[i],
+                    &heap_properties, D3D12_HEAP_FLAG_NONE, memories[i], NULL, NULL)))
+                goto fail;
+        }
+    }
+
     /* set Vulkan object names */
     vkd3d_set_vk_object_name_utf8(device, (uint64_t)null_resources->vk_buffer,
             VK_DEBUG_REPORT_OBJECT_TYPE_BUFFER_EXT, "NULL buffer");
@@ -5021,5 +5099,12 @@ void vkd3d_destroy_null_resources(struct vkd3d_null_resources *null_resources,
     VK_CALL(vkDestroyImage(device->vk_device, null_resources->vk_2d_storage_image, NULL));
     VK_CALL(vkFreeMemory(device->vk_device, null_resources->vk_2d_storage_image_memory, NULL));
 
+    VK_CALL(vkDestroyImage(device->vk_device, null_resources->vk_1d_image, NULL));
+    VK_CALL(vkFreeMemory(device->vk_device, null_resources->vk_1d_image_memory, NULL));
+    VK_CALL(vkDestroyImage(device->vk_device, null_resources->vk_3d_image, NULL));
+    VK_CALL(vkFreeMemory(device->vk_device, null_resources->vk_3d_image_memory, NULL));
+    VK_CALL(vkDestroyImage(device->vk_device, null_resources->vk_cube_image, NULL));
+    VK_CALL(vkFreeMemory(device->vk_device, null_resources->vk_cube_image_memory, NULL));
+
     memset(null_resources, 0, sizeof(*null_resources));
 }
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index 10b940d..1da084f 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -1516,6 +1516,14 @@ struct vkd3d_null_resources
 
     VkImage vk_2d_storage_image;
     VkDeviceMemory vk_2d_storage_image_memory;
+
+    /* Without nullDescriptor (MoltenVK), NULL SRVs of other dimensions are views of these. */
+    VkImage vk_1d_image;
+    VkDeviceMemory vk_1d_image_memory;
+    VkImage vk_3d_image;
+    VkDeviceMemory vk_3d_image_memory;
+    VkImage vk_cube_image;
+    VkDeviceMemory vk_cube_image_memory;
 };
 
 HRESULT vkd3d_init_null_resources(struct vkd3d_null_resources *null_resources, struct d3d12_device *device);
-- 
