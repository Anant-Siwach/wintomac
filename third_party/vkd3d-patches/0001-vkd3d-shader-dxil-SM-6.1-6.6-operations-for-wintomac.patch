+    [DX_DOT4_ADD_I8_PACKED            ] = {"i", "iii",  sm6_parser_emit_dx_dot4add_packed},
+    [DX_DOT4_ADD_U8_PACKED            ] = {"i", "iii",  sm6_parser_emit_dx_dot4add_packed},
     [DX_EMIT_STREAM                   ] = {"v", "c",    sm6_parser_emit_dx_stream},
