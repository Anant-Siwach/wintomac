+    [DX_CREATE_HANDLE_FROM_BINDING    ] = {"H", "oib",  sm6_parser_emit_dx_create_handle_from_binding},
+    [DX_ANNOTATE_HANDLE               ] = {"H", "Ho",   sm6_parser_emit_dx_annotate_handle},
+    [DX_PACK4X8                       ] = {"i", "ciiii", sm6_parser_emit_dx_pack4x8},
+    [DX_UNPACK4X8                     ] = {"V", "ci",   sm6_parser_emit_dx_unpack4x8},
+    [DX_VIEW_ID                       ] = {"i", "",     sm6_parser_emit_dx_view_id},
     [DX_CUT_STREAM                    ] = {"v", "c",    sm6_parser_emit_dx_stream},
     [DX_DERIV_COARSEX                 ] = {"e", "R",    sm6_parser_emit_dx_unary},
     [DX_DERIV_COARSEY                 ] = {"e", "R",    sm6_parser_emit_dx_unary},
@@ -7520,6 +7793,9 @@ static const struct sm6_dx_opcode_info sm6_dx_op_table[] =
     [DX_DOT2                          ] = {"g", "RRRR", sm6_parser_emit_dx_dot},
     [DX_DOT3                          ] = {"g", "RRRRRR", sm6_parser_emit_dx_dot},
     [DX_DOT4                          ] = {"g", "RRRRRRRR", sm6_parser_emit_dx_dot},
