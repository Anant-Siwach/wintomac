     [DX_EVAL_CENTROID                 ] = {"o", "cic",  sm6_parser_emit_dx_eval_attrib},
@@ -11426,6 +11702,23 @@ static enum vkd3d_result sm6_parser_entry_point_init(struct sm6_parser *sm6)
                     if ((ret = sm6_parser_emit_thread_group(sm6, node->operands[i + 1])) < 0)
                         return ret;
                     break;
+                case SHADER_PROPERTIES_WAVE_SIZE:
+                {
+                    const struct sm6_metadata_value *v = node->operands[i + 1];
+                    unsigned int wave_size = 0;
+
+                    /* SM 6.6 [WaveSize(n)]: the value is !{i32 n}. Apple GPUs (the only target of this build)
+                     * always run 32-wide SIMD groups, so 32 is honoured as is and anything else is refused. */
